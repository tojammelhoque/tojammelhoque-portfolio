# Email delivery for the contact form, over SMTP (set up for Gmail).
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Without SMTP_USER and SMTP_PASSWORD the form falls back to opening the visitor's email app.

# The Gmail account that sends and receives the enquiries.
# It stays in the backend: it is never shown on the website.
SMTP_USER=your-gmail-address@gmail.com

# A Gmail "App password" (16 characters). This is NOT your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords (2-Step Verification must be on).
SMTP_PASSWORD=

# Optional. The defaults suit Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Optional. Where enquiries are delivered. Defaults to SMTP_USER.
# CONTACT_TO_EMAIL=
